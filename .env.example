DATABASE_URL=postgresql://riff_sketchbook_app@127.0.0.1:5432/riff_sketchbook
SESSION_COOKIE_NAME=riff_session
APP_ORIGIN=http://127.0.0.1:3000
RIFF_REMOTE_ACCESS=0

# Postgres.app의 기본 관리자가 macOS 로그인 계정과 다른 경우에만 설정하세요.
# PG_ADMIN_USER=postgres
# PG_ADMIN_PASSWORD=
# 전체 로컬 관리자 URL을 직접 주려면 위 두 값 대신 아래 값을 사용할 수 있어요.
# PG_ADMIN_URL=postgresql://postgres@127.0.0.1:5432/postgres

# HTTPS 임시 공유 실행기는 아래 두 값을 실행 시점에 안전하게 덮어씁니다.
# 직접 프록시를 연결할 때만 RIFF_REMOTE_ACCESS=1로 바꾸고, APP_ORIGIN에는
# 경로나 마지막 /가 없는 정확한 HTTPS 주소를 넣으세요.
# APP_ORIGIN=https://quiet-riff-bridge.trycloudflare.com
